APP_NAME=Auto Escrow API
APP_ENV=development
DATABASE_URL=sqlite:///./auto_escrow.db
# Used only when APP_ENV=test; it keeps test data isolated from development.
TEST_DATABASE_URL=sqlite:///./test_auto_escrow.db
# Comma-separated exact browser origins; development also allows local Next.js and Vite origins.
FRONTEND_ORIGIN=http://localhost:3000
MAX_SUBMISSION_RETRIES=2
DEMO_RESOLUTION_OPERATOR=demo-operator
# Local-only: leave blank for an ephemeral process secret. Production requires
# a random private value of at least 32 characters, never a NEXT_PUBLIC variable.
DEMO_SESSION_SECRET=
DEMO_SESSION_TTL_SECONDS=3600
DEMO_MAX_JOBS_PER_SESSION=3
DEMO_MAX_JOB_BUDGET=500.00
DEMO_RATE_LIMIT_PER_MINUTE=300
DEMO_MAX_REQUEST_BYTES=200000
DEMO_PUBLIC_RESOLUTION_ENABLED=true
# Production stays access-code gated unless explicitly opened by the owner.
DEMO_PUBLIC_ACCESS=false
DEMO_ACCESS_CODE=
DEMO_MAX_SESSIONS=200
DEMO_MAX_MUTATIONS_PER_SESSION=100
